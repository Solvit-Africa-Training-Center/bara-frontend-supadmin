{
  "info": {
    "name": "Bara Super Admin API",
    "description": "Every endpoint the Bara Super Admin app uses.\n\n1. Set `email` in the collection variables, run **1. Sign in › Request PIN**, and check your email.\n2. Put the 6-digit PIN in `pin` and run **Verify PIN**: it saves `accessToken` for every other request.\n3. Run folders 2–4 (read-only).\n\nFolder 5 changes a real restaurant's status: run it only on a test restaurant. It ends with Reactivate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://shirt-shady-daisy.ngrok-free.dev/api"
    },
    {
      "key": "email",
      "value": "uwitonzesonia2005@gmail.com"
    },
    {
      "key": "pin",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "restaurantId",
      "value": ""
    },
    {
      "key": "restaurantCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sign in",
      "item": [
        {
          "name": "Request PIN (emails a 6-digit PIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "ngrok-skip-browser-warning",
                "value": "1"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin/request-pin/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "admin",
                "request-pin",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify PIN (saves tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns access and refresh tokens', () => { pm.expect(body.access).to.be.a('string'); pm.expect(body.refresh).to.be.a('string'); });",
                  "pm.collectionVariables.set('accessToken', body.access);",
                  "pm.collectionVariables.set('refreshToken', body.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "ngrok-skip-browser-warning",
                "value": "1"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin/verify-pin/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "admin",
                "verify-pin",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"pin\": \"{{pin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Profile (who am I)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "ngrok-skip-browser-warning",
                "value": "1"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile",
                ""
              ]
            }
          }
        },
        {
          "name": "Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); pm.test('Returns new access token', () => pm.expect(b.access).to.be.a('string')); pm.collectionVariables.set('accessToken', b.access); if (b.refresh) pm.collectionVariables.set('refreshToken', b.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "ngrok-skip-browser-warning",
                "value": "1"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Restaurants (Restaurants tab + Home)",
      "item": [
        {
          "name": "List restaurants",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns a list', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "const list = pm.response.json();",
                  "const ok = ['pending_payment','active','grace','restricted','locked','archived'];",
                  "pm.test('Every restaurant has the fields the app shows', () => list.forEach((r) => { ['id','name','code','account_status','subscription_tier','manager','city'].forEach((k) => pm.expect(r).to.have.property(k)); pm.expect(ok).to.include(r.account_status); }));",
                  "console.log(`${list.length} restaurants, ${list.filter((r) => r.account_status === 'active').length} active`);",
                  "if (list[0]) { pm.collectionVariables.set('restaurantId', list[0].id); pm.collectionVariables.set('restaurantCode', list[0].code); }"
                ]
              }
            }
