# Copy to .env to point the app at another Bara backend (no trailing slash).
EXPO_PUBLIC_API_URL=https://bara-backend-5g84.onrender.com/api

# DEV ONLY (optional): a Super Admin refresh token. Shows "Skip sign-in (dev)" on the sign-in screen
# in development builds. Never commit a real token.
# EXPO_PUBLIC_DEV_REFRESH_TOKEN=
